{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Real values belong in `dotnet user-secrets` (per-machine, outside the repo) for local dev,
  // and in the ConnectionStrings__DefaultConnection / Jwt__Key environment variables in production.
  // Do not put real credentials in this file - it's committed to source control.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "UserAuthenticationServer",
    "Audience": "UserServiceClient",
    "Subject": "UserServiceAccessToken"
  },
  "AllowedHosts": "*"
}
